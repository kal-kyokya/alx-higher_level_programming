#!/usr/bin/env node
// Toggles the class of the 'header' element on 'div' click

try {
  $('document').ready(function () {
    $('header').addClass('green');
    $('#toggle_header').click( function () {
      $('header').toggleClass('red');
      $('header').toggleClass('green');
    });
  });
} catch (e) {
  console.log(e);
}
